{
  "openapi": "3.1.0",
  "info": {
    "title": "Abyssale selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.abyssale.com"
    }
  ],
  "paths": {
    "/designs": {
      "get": {
        "operationId": "abyssale_list_designs",
        "summary": "abyssale list designs",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/generation-request/{generationRequestId}": {
      "get": {
        "operationId": "abyssale_get_generation",
        "summary": "abyssale get generation",
        "parameters": [
          {
            "name": "generationRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/async/banner-builder/{designId}/generate": {
      "post": {
        "operationId": "abyssale_generate_formats",
        "summary": "Queue asset generation using an existing design; poll get_generation. Acceptance does not mean files are finished.",
        "parameters": [
          {
            "name": "designId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template_format_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "elements": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
